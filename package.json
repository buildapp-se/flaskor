{
  "name": "flaskor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "check": "tsc -b && vitest run && npm run test:worker && npm run worker:check",
    "worker:dev": "wrangler dev",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:check": "wrangler deploy --dry-run --outdir worker/dist",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply flaskor --local",
    "db:migrate:remote": "wrangler d1 migrations apply flaskor --remote",
    "seed": "node scripts/seed.ts",
    "seed:bar": "node scripts/seed-bar.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "~5.9.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.30.0"
  }
}
