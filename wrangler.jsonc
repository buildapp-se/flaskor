{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flaskor-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "flaskor-api.buildapp.se", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flaskor",
      // Skapad 2026-09-05 med `wrangler d1 create flaskor`, region EEUR.
      "database_id": "5de22007-de02-4160-80c2-662b1eeca130",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    // Bara produktionens ursprung här; localhost-listan för wrangler dev ligger i .dev.vars (OWASP 2026-09-16, låg).
    "FRONTEND_ORIGINS": "https://buildapp.se,https://www.buildapp.se",
    // Firebase-projektet för inloggningen (beslut 2, 2026-09-15). Inte hemligt: det står i varje ID-token.
    "FIREBASE_PROJECT_ID": "flaskor-d3762"
  },
  // Tak per konto (2026-09-15). Perioden får bara vara 10 eller 60 s. Skanningen går till Geminis gratisnivå, som delas av alla.
  "ratelimits": [
    { "name": "SCAN_LIMIT", "namespace_id": "8001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "8002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Nattlig uppdatering från Systembolaget 04:00 svensk sommartid, 03:00 vintertid (cron är UTC), beslut 23
  "triggers": { "crons": ["0 2 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
