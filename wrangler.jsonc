{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flaskor-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "flaskor-api.buildapp.se", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flaskor",
      // Skapas av Patrik med `wrangler d1 create flaskor`; klistra in id:t här. Lokalt spelar värdet ingen roll.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "FRONTEND_ORIGINS": "https://buildapp.se,https://www.buildapp.se,http://localhost:5173,http://localhost:5180,http://127.0.0.1:5173,http://127.0.0.1:5180"
  },
  // Nattlig uppdatering från Systembolaget 04:00 svensk sommartid, 03:00 vintertid (cron är UTC), beslut 23
  "triggers": { "crons": ["0 2 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
